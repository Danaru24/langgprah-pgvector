# =============================================================================
#  Plantilla de variables de entorno.  Copiar:  cp .env.example .env
#  (.env está en .gitignore — NUNCA se versiona)
# =============================================================================

# --- PostgreSQL + pgvector ----------------------------------------------------
# Opción A: URL completa (si se define, tiene prioridad sobre las PG*)
# DATABASE_URL=postgresql://usuario:password@host:5432/payworks?sslmode=require
PGHOST=postgresql.mi-namespace.svc.cluster.local
PGPORT=5432
PGDATABASE=payworks
PGUSER=payworks
PGPASSWORD=cambiar_me
PGSSLMODE=prefer

# --- Modo de inferencia -------------------------------------------------------
# local_cpu        -> SentenceTransformers en el CPU del Workbench
# openai_endpoint  -> HTTP POST {base_url}/v1/embeddings (vLLM / HF TEI en OpenShift AI)
INFERENCE_MODE=openai_endpoint

# Modelo por defecto cuando no se pasa --modelo (solo UN modelo levantado a la vez)
# Opciones: bge-m3 | multilingual-e5-large | embeddinggemma-300m | granite-278m-multilingual | all-MiniLM-L6-v2
ACTIVE_MODEL=bge-m3

# --- Endpoint OpenAI-compatible (modo openai_endpoint) ------------------------
# Valor genérico (aplica al modelo que esté levantado):
EMBEDDING_BASE_URL=https://bge-m3-mi-namespace.apps.cluster.example.com/v1
EMBEDDING_API_KEY=

# Nombre con el que vLLM/KServe expone el modelo en /v1/models.
# NOTA: En OpenShift AI el nombre servido puede diferir del Hugging Face ID (BAAI/bge-m3).
# Por ejemplo, en el despliegue observado /v1/models reporta "redhataibge-m3".
# Si se deja vacío, el cliente consultará /v1/models e intentará alinearlo automáticamente.
EMBEDDING_SERVED_MODEL_NAME=

# Overrides opcionales POR MODELO (sufijo = ID corto en MAYÚSCULAS, no alfanuméricos -> "_").
# Permiten pre-configurar las 5 URLs y solo cambiar --modelo al rotar despliegues.
# EMBEDDING_BASE_URL__BGE_M3=https://bge-m3-ns.apps.cluster.example.com/v1
# EMBEDDING_SERVED_MODEL_NAME__BGE_M3=redhataibge-m3
# EMBEDDING_BASE_URL__MULTILINGUAL_E5_LARGE=https://e5-ns.apps.cluster.example.com/v1
# EMBEDDING_SERVED_MODEL_NAME__MULTILINGUAL_E5_LARGE=multilingual-e5-large
# EMBEDDING_BASE_URL__EMBEDDINGGEMMA_300M=https://gemma-ns.apps.cluster.example.com/v1
# EMBEDDING_BASE_URL__GRANITE_278M_MULTILINGUAL=https://granite-ns.apps.cluster.example.com/v1
# EMBEDDING_BASE_URL__ALL_MINILM_L6_V2=https://minilm-ns.apps.cluster.example.com/v1
# EMBEDDING_API_KEY__BGE_M3=

# true | false | /ruta/al/ca-bundle.crt  (rutas internas de OpenShift suelen usar CA propia)
EMBEDDING_VERIFY_SSL=true
EMBEDDING_TIMEOUT_S=120
EMBEDDING_MAX_RETRIES=5
# >0 envía "truncate_prompt_tokens" (vLLM). 0 = no enviar (TEI usa --auto-truncate en servidor)
EMBEDDING_TRUNCATE_PROMPT_TOKENS=0

# --- Hugging Face / CPU -------------------------------------------------------
# Relativo a la raíz del repo -> ./models_cache (ignorado por git)
HF_HOME=./models_cache
# Necesario para modelos con acceso restringido (google/embeddinggemma-300m)
HF_TOKEN=
# Contar tokens con el tokenizer real del modelo (para medir truncamiento). false = chars/4
USE_HF_TOKENIZER=true
# Hilos de PyTorch (0 = auto). Recomendado = límite de CPU del pod para evitar oversubscription
TORCH_NUM_THREADS=0
EMBED_BATCH_SIZE=16

# --- Evaluación ---------------------------------------------------------------
# exact = KNN exacto (recomendado para benchmark científico) | hnsw = índice ANN
SEARCH_MODE=exact
HNSW_EF_SEARCH=100
LOG_LEVEL=INFO

# --- Rutas (relativas a la raíz del repo) ------------------------------------
DOC_PATH=docs/Payworks_Master_RAG.md
GOLDEN_DATASET_PATH=docs/golden_dataset.json
RESULTS_DIR=results
